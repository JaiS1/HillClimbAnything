         return text.split("\n")
 
+    @staticmethod
+    def _next_fence(text: str, index: int) -> int:
+        """
+        Return the first position at or after `index` where a line starts with three backticks or tildes
+        (the only places a fenced block can open), or the length of `text` if there is none.
+        """
+        first = len(text)
+        for fence in ('```', '~~~'):
+            i = text.find(fence, index, first + 2)
+            while i != -1 and i > 0 and text[i - 1] != '\n':
+                i = text.find(fence, i + 1, first + 2)
+            if i != -1:
+                first = i
+        return first
+
