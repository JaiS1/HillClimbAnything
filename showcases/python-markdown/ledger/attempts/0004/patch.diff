@@ -25,6 +25,8 @@ throughout the code base.
 from __future__ import annotations
 
 import re
+import re._constants as _sre_constants
+import re._parser as _sre_parse
 import sys
 import warnings
 from functools import wraps, lru_cache
@@ -183,6 +185,63 @@ def nearing_recursion_limit() -> bool:
 # =============================================================================
 
 
+def _required_chars(items) -> frozenset[str] | None:
+    """
+    Return a set of characters, at least one of which must appear in every match of the
+    parsed regular expression `items`, or `None` if no such set is known.
+    """
+    best: frozenset[str] | None = None
+    for op, av in items:
+        chars = None
+        if op is _sre_constants.LITERAL:
+            chars = frozenset(chr(av))
+        elif op is _sre_constants.IN:
+            if all(o is _sre_constants.LITERAL for o, _ in av):
+                chars = frozenset(chr(a) for _, a in av)
+        elif op is _sre_constants.BRANCH:
+            alternatives = [_required_chars(branch) for branch in av[1]]
+            if all(alternatives):
+                chars = frozenset().union(*alternatives)
+        elif op is _sre_constants.SUBPATTERN:
+            if not av[1] & re.IGNORECASE:
+                chars = _required_chars(av[3])
+        elif op in (_sre_constants.MAX_REPEAT, _sre_constants.MIN_REPEAT, _sre_constants.POSSESSIVE_REPEAT):
+            if av[0] >= 1:
+                chars = _required_chars(av[2])
+        elif op is _sre_constants.ATOMIC_GROUP:
+            chars = _required_chars(av)
+        if chars and (
+            best is None or len(chars) < len(best) or (
+                len(chars) == len(best) and _is_common(best) and not _is_common(chars)
+            )
+        ):
+            best = chars
+    return best
+
+
+def _is_common(chars: frozenset[str]) -> bool:
+    """ Whether `chars` holds only characters that occur in nearly every piece of text. """
+    return all(c == " " or c.isalnum() for c in chars)
+
+
+@lru_cache(maxsize=1024)
+def required_char(regex: re.Pattern[str]) -> str | None:
+    """
+    Return a single character which every match of the compiled `regex` must contain, or `None`.
+
+    A text which does not contain the character cannot match, which lets a caller skip the
+    (much slower) regular expression search. The answer is derived from the regular expression
+    alone and `None` is returned whenever it cannot be determined with certainty.
+    """
+    try:
+        if regex.flags & re.IGNORECASE:
+            return None
+        chars = _required_chars(_sre_parse.parse(regex.pattern, regex.flags))
+    except Exception:  # pragma: no cover
+        return None
+    return next(iter(chars)) if chars is not None and len(chars) == 1 else None
+
+
 class AtomicString(str):
     """A string which should not be further processed."""
     pass
