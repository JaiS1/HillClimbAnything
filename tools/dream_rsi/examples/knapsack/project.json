{
  "name": "Pack more value",
  "question": "Improve a knapsack selection under fixed capacity. Change only candidate files. The evaluator decides feasibility and value.",
  "metric": {"name": "knapsack_value", "direction": "max", "identity": "knapsack-12-cap45-v1"},
  "seed_dir": "seed",
  "evaluate": ["{python}", "{config_dir}/evaluate.py"],
  "generate": ["{python}", "{config_dir}/propose.py"],
  "generator_files": ["propose.py"],
  "verifier_files": ["evaluate.py"],
  "limits": {"attempts": 18, "wall_seconds": 120, "command_seconds": 5, "max_artifact_bytes": 100000},
  "policy": {"name": "round_robin", "width": 3, "patience": 8}
}
